# Copy to .env (local) or set in Railway → Variables. Never commit real values.

# --- Required ---------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# "require" for Supabase/Railway, "off" for local Postgres
DATABASE_SSL=require
# Kept for compatibility (sessions are now stored in the database). Any long random string.
SESSION_SECRET=change-me
PORT=8080
NODE_ENV=production

# --- First start on an EMPTY database only -----------------------------------
# Owner's personal code (4-8 digits), applied once if the owner has no code yet.
# Remove it after the first successful login. Not needed when migrating from Replit.
OWNER_INITIAL_CODE=
# Leave unset. "1" re-enables setting the owner code from the website (unsafe on a public URL).
# ALLOW_OWNER_BOOTSTRAP=

# --- WhatsApp ---------------------------------------------------------------
# Folder for linked WhatsApp sessions. On Railway attach a Volume mounted at /data.
WHATSAPP_AUTH_DIR=/data/whatsapp

# --- Optional ---------------------------------------------------------------
# Google Routes API key for estimating prices of unlisted routes
GOOGLE_MAPS_API_KEY=
# debug | info | warn | error
LOG_LEVEL=info
# Number of proxies in front of the app (Railway = 1)
TRUST_PROXY_HOPS=1
DATABASE_POOL_MAX=10
# Public address of the site, used in WhatsApp invitations (default: the address the owner is using)
APP_URL=https://your-domain.example
# How long a sign-in lasts on a device (days). Sessions can be revoked any time from the Users page.
SESSION_DAYS=30
# "0" skips automatic database migrations on start (not recommended)
# DB_AUTO_MIGRATE=
