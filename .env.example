# Copy to .env (local) or set in Railway → Variables. Never commit real values.

# --- Required ---------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# "require" for Supabase/Railway, "off" for local Postgres
DATABASE_SSL=require
# Long random string that signs login cookies. Generate: openssl rand -base64 48
SESSION_SECRET=change-me
PORT=8080
NODE_ENV=production

# --- WhatsApp ---------------------------------------------------------------
# Folder for linked WhatsApp sessions. On Railway attach a Volume mounted at /data.
WHATSAPP_AUTH_DIR=/data/whatsapp

# --- Optional ---------------------------------------------------------------
# Google Routes API key for estimating prices of unlisted routes
GOOGLE_MAPS_API_KEY=
# debug | info | warn | error
LOG_LEVEL=info
# Number of proxies in front of the app (Railway = 1)
TRUST_PROXY_HOPS=1
DATABASE_POOL_MAX=10
